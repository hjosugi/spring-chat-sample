root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java follows Spring's own style.
[*.java]
indent_style = tab

[*.{xml,html,css,properties}]
indent_style = space
indent_size = 4

[*.{js,yml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
